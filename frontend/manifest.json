{
  "manifest_version": 3,
  "name": "TagIt",
  "version": "1.0.0",
  "description": "A Chrome extension built with Vite and React",

  "permissions": ["sidePanel"],

  "action": {
    "default_title": "TagIt"
  },

  "background": {
  "service_worker": "src/background.js",
  "type": "module"
  },

  "side_panel": {
    "default_path": "index.html"
  }
}