{
  "manifest_version": 3,
  "name": "TagIt",
  "version": "1.0.0",
  "description": "A Chrome extension built with Vite and React",

  "permissions": ["sidePanel", "activeTab", "scripting", "identity", "storage"],

  "action": {
    "default_title": "TagIt"
  },

  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ],

  "side_panel": {
    "default_path": "index.html"
  }
}
