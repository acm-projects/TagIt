# Google OAuth 2.0 (Gmail / sign-in)
# Create a "Web application" client in Google Cloud Console (APIs & Services → Credentials).
# Add authorized redirect URI: https://<YOUR_EXTENSION_ID>.chromiumapp.org/
# (Get extension ID from chrome://extensions after loading the unpacked extension.)
VITE_GOOGLE_CLIENT_ID=

# Microsoft (Outlook) OAuth — not used yet; add when implementing Microsoft auth.
# VITE_MICROSOFT_CLIENT_ID=
